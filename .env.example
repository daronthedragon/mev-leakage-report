# Everything here is OPTIONAL. With no .env at all the tool uses a public
# mainnet RPC and Blockscout for history, which need no signup.

# JSON-RPC endpoint. A dedicated one (Alchemy, Infura, QuickNode) is faster and
# will not rate limit a long scan. No archive node required.
RPC_URL=

# Etherscan API key. Only changes where the transaction list comes from.
# Without it, history is read from Blockscout instead.
ETHERSCAN_API_KEY=

# Chain id, defaults to 1 (Ethereum mainnet). Set RPC_URL too if you change it.
CHAIN_ID=1
