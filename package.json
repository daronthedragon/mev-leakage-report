{
  "name": "mev-leakage-report",
  "version": "0.1.0",
  "description": "Find out how much value MEV bots have extracted from your wallet.",
  "type": "module",
  "bin": {
    "mev-leakage": "./dist/index.js"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "test": "node --import tsx --test src/*.test.ts"
  },
  "keywords": [
    "mev",
    "sandwich",
    "ethereum",
    "defi",
    "uniswap"
  ],
  "license": "MIT",
  "dependencies": {
    "dotenv": "^16.4.5",
    "picocolors": "^1.1.1",
    "viem": "^2.21.0"
  },
  "devDependencies": {
    "@types/node": "^22.7.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
